{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pace-m5",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [{"name": "THROWS", "class_name": "ThrowRelay"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ThrowRelay"]}],
  "build": {"command": "node cloud/build.mjs"}
}
